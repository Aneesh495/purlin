module proto/fsm

import std/core/list
import std/core/string
import proto/types
import proto/wire
import proto/capabilities
import proto/message

// RFC 4271 §8.2.1 BGP FSM States
pub type fsm-state
  StateIdle
  StateConnect
  StateActive
  StateOpenSent
  StateOpenConfirm
  StateEstablished

pub fun fsm-state/show(s : fsm-state) : string {
  match s
    StateIdle -> "IDLE"
    StateConnect -> "CONNECT"
    StateActive -> "ACTIVE"
    StateOpenSent -> "OPENSENT"
    StateOpenConfirm -> "OPENCONFIRM"
    StateEstablished -> "ESTABLISHED"
}

pub fun fsm-state/(==)(a : fsm-state, b : fsm-state) : bool {
  match (a, b)
    (StateIdle, StateIdle) -> True
    (StateConnect, StateConnect) -> True
    (StateActive, StateActive) -> True
    (StateOpenSent, StateOpenSent) -> True
    (StateOpenConfirm, StateOpenConfirm) -> True
    (StateEstablished, StateEstablished) -> True
    _ -> False
}

// RFC 4271 §8.1 BGP FSM Events
pub type fsm-event
  EvManualStart
  EvManualStop
  EvConnectRetryTimerExpires
  EvHoldTimerExpires
  EvKeepaliveTimerExpires
  EvTcpConnectionConfirmed
  EvTcpConnectionFails
  EvRecvOpen(msg : bgp-message)
  EvRecvKeepalive
  EvRecvUpdate(msg : bgp-message)
  EvRecvNotification(code : int, subcode : int)

pub fun fsm-event/show(ev : fsm-event) : string {
  match ev
    EvManualStart -> "EvManualStart"
    EvManualStop -> "EvManualStop"
    EvConnectRetryTimerExpires -> "EvConnectRetryTimerExpires"
    EvHoldTimerExpires -> "EvHoldTimerExpires"
    EvKeepaliveTimerExpires -> "EvKeepaliveTimerExpires"
    EvTcpConnectionConfirmed -> "EvTcpConnectionConfirmed"
    EvTcpConnectionFails -> "EvTcpConnectionFails"
    EvRecvOpen(m) -> "EvRecvOpen(" ++ m.show ++ ")"
    EvRecvKeepalive -> "EvRecvKeepalive"
    EvRecvUpdate(m) -> "EvRecvUpdate(" ++ m.show ++ ")"
    EvRecvNotification(c, sc) -> "EvRecvNotification(" ++ c.show ++ ", " ++ sc.show ++ ")"
}

// Action generated by FSM transition
pub type fsm-action
  ActNone
  ActStartConnectRetryTimer(seconds : int)
  ActInitTcpConnection
  ActCloseTcpConnection
  ActSendOpen
  ActSendKeepalive
  ActSendNotification(code : int, subcode : int, data : list<int>)
  ActStartHoldTimer(seconds : int)
  ActStartKeepaliveTimer(seconds : int)
  ActSessionEstablished
  ActSessionTeardown(reason : string)

pub fun fsm-action/show(act : fsm-action) : string {
  match act
    ActNone -> "ActNone"
    ActStartConnectRetryTimer(s) -> "ActStartConnectRetryTimer(" ++ s.show ++ "s)"
    ActInitTcpConnection -> "ActInitTcpConnection"
    ActCloseTcpConnection -> "ActCloseTcpConnection"
    ActSendOpen -> "ActSendOpen"
    ActSendKeepalive -> "ActSendKeepalive"
    ActSendNotification(c, sc, _) -> "ActSendNotification(" ++ c.show ++ ", " ++ sc.show ++ ")"
    ActStartHoldTimer(s) -> "ActStartHoldTimer(" ++ s.show ++ "s)"
    ActStartKeepaliveTimer(s) -> "ActStartKeepaliveTimer(" ++ s.show ++ "s)"
    ActSessionEstablished -> "ActSessionEstablished"
    ActSessionTeardown(r) -> "ActSessionTeardown(" ++ r ++ ")"
}

pub fun fsm-action/(==)(a : fsm-action, b : fsm-action) : bool {
  match (a, b)
    (ActNone, ActNone) -> True
    (ActStartConnectRetryTimer(s1), ActStartConnectRetryTimer(s2)) -> s1 == s2
    (ActInitTcpConnection, ActInitTcpConnection) -> True
    (ActCloseTcpConnection, ActCloseTcpConnection) -> True
    (ActSendOpen, ActSendOpen) -> True
    (ActSendKeepalive, ActSendKeepalive) -> True
    (ActSendNotification(c1, s1, d1), ActSendNotification(c2, s2, d2)) -> c1 == c2 && s1 == s2 && d1 == d2
    (ActStartHoldTimer(s1), ActStartHoldTimer(s2)) -> s1 == s2
    (ActStartKeepaliveTimer(s1), ActStartKeepaliveTimer(s2)) -> s1 == s2
    (ActSessionEstablished, ActSessionEstablished) -> True
    (ActSessionTeardown(r1), ActSessionTeardown(r2)) -> r1 == r2
    _ -> False
}

// BGP FSM Session Configuration
pub struct fsm-config
  local-asn           : asn
  remote-asn          : asn
  local-router-id     : router-id
  remote-router-id    : router-id
  hold-time-configured : int // Default 90 seconds
  connect-retry-time  : int // Default 30 seconds

pub fun fsm-config-create(l-asn : asn, r-asn : asn, l-id : router-id, r-id : router-id) : fsm-config {
  Fsm-config(l-asn, r-asn, l-id, r-id, 90, 30)
}

// BGP Connection Collision Detection (RFC 4271 §6.8):
// When two peers simultaneously attempt to open a session, compare Router IDs.
// True means the local peer has precedence (higher Router ID); remote incoming connection can proceed.
// False means the remote peer has precedence; local connection should be closed.
pub fun resolve-connection-collision(local-id : router-id, remote-id : router-id) : bool {
  local-id > remote-id
}

// Transition Result: New State + Ordered List of Actions
pub struct transition-result
  next-state : fsm-state
  actions    : list<fsm-action>

pub fun tr(st : fsm-state, acts : list<fsm-action>) : transition-result {
  Transition-result(st, acts)
}

// Execute an RFC 4271 BGP Finite State Machine step
pub fun step-fsm(current-state : fsm-state, event : fsm-event, config : fsm-config) : transition-result {
  match current-state
    // --- IDLE STATE ---
    StateIdle -> match event
      EvManualStart -> {
        // Event 1: Initialize ConnectRetry timer, initiate TCP connection
        tr(StateConnect, [
          ActStartConnectRetryTimer(config.connect-retry-time),
          ActInitTcpConnection
        ])
      }
      _ -> tr(StateIdle, [ActNone])

    // --- CONNECT STATE ---
    StateConnect -> match event
      EvManualStop -> {
        tr(StateIdle, [ActCloseTcpConnection, ActSessionTeardown("ManualStop in Connect")])
      }
      EvConnectRetryTimerExpires -> {
        // Restart connection attempt
        tr(StateConnect, [
          ActStartConnectRetryTimer(config.connect-retry-time),
          ActInitTcpConnection
        ])
      }
      EvTcpConnectionConfirmed -> {
        // TCP established: send OPEN, start hold timer (e.g. 240s for OpenSent)
        tr(StateOpenSent, [
          ActSendOpen,
          ActStartHoldTimer(240)
        ])
      }
      EvTcpConnectionFails -> {
        // Move to Active state to retry
        tr(StateActive, [
          ActStartConnectRetryTimer(config.connect-retry-time)
        ])
      }
      _ -> tr(StateConnect, [ActNone])

    // --- ACTIVE STATE ---
    StateActive -> match event
      EvManualStop -> {
        tr(StateIdle, [ActCloseTcpConnection, ActSessionTeardown("ManualStop in Active")])
      }
      EvConnectRetryTimerExpires -> {
        // Retry connection
        tr(StateConnect, [
          ActStartConnectRetryTimer(config.connect-retry-time),
          ActInitTcpConnection
        ])
      }
      EvTcpConnectionConfirmed -> {
        tr(StateOpenSent, [
          ActSendOpen,
          ActStartHoldTimer(240)
        ])
      }
      EvTcpConnectionFails -> {
        tr(StateIdle, [
          ActStartConnectRetryTimer(config.connect-retry-time),
          ActSessionTeardown("TCP connection failed in Active")
        ])
      }
      _ -> tr(StateActive, [ActNone])

    // --- OPENSENT STATE ---
    StateOpenSent -> match event
      EvManualStop -> {
        tr(StateIdle, [
          ActSendNotification(err-code-cease, subcode-admin-shutdown, []),
          ActCloseTcpConnection,
          ActSessionTeardown("ManualStop in OpenSent")
        ])
      }
      EvHoldTimerExpires -> {
        tr(StateIdle, [
          ActSendNotification(err-code-hold-timer-exp, 0, []),
          ActCloseTcpConnection,
          ActSessionTeardown("HoldTimer expired in OpenSent")
        ])
      }
      EvTcpConnectionFails -> {
        tr(StateActive, [
          ActCloseTcpConnection,
          ActStartConnectRetryTimer(config.connect-retry-time)
        ])
      }
      EvRecvOpen(MsgOpen(ver, peer-a, remote-ht, rid, _)) -> {
        // Validate OPEN message
        if ver != 4 then {
          tr(StateIdle, [
            ActSendNotification(err-code-open-message, subcode-bad-version, [4]),
            ActCloseTcpConnection,
            ActSessionTeardown("Unsupported BGP version")
          ])
        } elif peer-a != config.remote-asn then {
          tr(StateIdle, [
            ActSendNotification(err-code-open-message, subcode-bad-peer-as, []),
            ActCloseTcpConnection,
            ActSessionTeardown("Peer ASN mismatch")
          ])
        } elif rid == config.local-router-id then {
          tr(StateIdle, [
            ActSendNotification(err-code-open-message, subcode-bad-bgp-id, []),
            ActCloseTcpConnection,
            ActSessionTeardown("BGP Router ID collision with local router")
          ])
        } else {
          // Negotiate hold time: minimum of configured and received
          val negotiated-ht = if remote-ht < config.hold-time-configured then remote-ht else config.hold-time-configured
          val keepalive-time = if negotiated-ht > 0 then negotiated-ht / 3 else 0
          
          tr(StateOpenConfirm, [
            ActSendKeepalive,
            ActStartHoldTimer(negotiated-ht),
            ActStartKeepaliveTimer(keepalive-time)
          ])
        }
      }
      EvRecvNotification(c, sc) -> {
        tr(StateIdle, [
          ActCloseTcpConnection,
          ActSessionTeardown("Notification received: " ++ c.show ++ "/" ++ sc.show)
        ])
      }
      _ -> tr(StateOpenSent, [ActNone])

    // --- OPENCONFIRM STATE ---
    StateOpenConfirm -> match event
      EvManualStop -> {
        tr(StateIdle, [
          ActSendNotification(err-code-cease, subcode-admin-shutdown, []),
          ActCloseTcpConnection,
          ActSessionTeardown("ManualStop in OpenConfirm")
        ])
      }
      EvHoldTimerExpires -> {
        tr(StateIdle, [
          ActSendNotification(err-code-hold-timer-exp, 0, []),
          ActCloseTcpConnection,
          ActSessionTeardown("HoldTimer expired in OpenConfirm")
        ])
      }
      EvKeepaliveTimerExpires -> {
        tr(StateOpenConfirm, [ActSendKeepalive])
      }
      EvRecvKeepalive -> {
        // Successful KEEPALIVE received: peering is ESTABLISHED!
        tr(StateEstablished, [
          ActStartHoldTimer(config.hold-time-configured),
          ActSessionEstablished
        ])
      }
      EvRecvNotification(c, sc) -> {
        tr(StateIdle, [
          ActCloseTcpConnection,
          ActSessionTeardown("Notification received in OpenConfirm: " ++ c.show ++ "/" ++ sc.show)
        ])
      }
      EvTcpConnectionFails -> {
        tr(StateIdle, [
          ActCloseTcpConnection,
          ActSessionTeardown("TCP connection failed in OpenConfirm")
        ])
      }
      _ -> tr(StateOpenConfirm, [ActNone])

    // --- ESTABLISHED STATE ---
    StateEstablished -> match event
      EvManualStop -> {
        tr(StateIdle, [
          ActSendNotification(err-code-cease, subcode-admin-shutdown, []),
          ActCloseTcpConnection,
          ActSessionTeardown("ManualStop in Established")
        ])
      }
      EvHoldTimerExpires -> {
        tr(StateIdle, [
          ActSendNotification(err-code-hold-timer-exp, 0, []),
          ActCloseTcpConnection,
          ActSessionTeardown("HoldTimer expired in Established")
        ])
      }
      EvKeepaliveTimerExpires -> {
        tr(StateEstablished, [ActSendKeepalive])
      }
      EvRecvKeepalive -> {
        // Reset hold timer on incoming KEEPALIVE
        tr(StateEstablished, [ActStartHoldTimer(config.hold-time-configured)])
      }
      EvRecvUpdate(_) -> {
        // Reset hold timer on incoming UPDATE
        tr(StateEstablished, [ActStartHoldTimer(config.hold-time-configured)])
      }
      EvRecvNotification(c, sc) -> {
        tr(StateIdle, [
          ActCloseTcpConnection,
          ActSessionTeardown("Notification received in Established: " ++ c.show ++ "/" ++ sc.show)
        ])
      }
      EvTcpConnectionFails -> {
        tr(StateIdle, [
          ActCloseTcpConnection,
          ActStartConnectRetryTimer(config.connect-retry-time),
          ActSessionTeardown("TCP connection lost in Established")
        ])
      }
      _ -> tr(StateEstablished, [ActNone])
}
